# ----------------------------------------------------------------------------
# Naqshkaar Catalogue Studio configuration.
# The setup scripts (setup.ps1 / setup.sh) create .env from this file and fill
# the secrets for you. To do it by hand: copy to .env and replace every CHANGE_ME.
# Keep comments on their own lines. Never commit .env (it is in .gitignore).
# ----------------------------------------------------------------------------

# PostgreSQL. The bundled 'db' container creates the database from these.
# Use letters and digits only in the password (it goes inside a URL).
POSTGRES_USER=naqshkaar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=naqshkaar_catalogue

# Signs login sessions and file links. Any long random string.
SECRET_KEY=CHANGE_ME

# First admin account, created on first start if it does not exist yet.
# The password must be at least 10 characters.
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=Admin

# Ports on your computer. Change one if it is already in use.
DB_PORT=5432
API_PORT=8000
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# File storage: local (a Docker volume) or s3 (AWS S3, MinIO, Cloudflare R2).
STORAGE_BACKEND=local
# For s3 only. With the bundled MinIO use S3_ENDPOINT_URL=http://minio:9000
S3_ENDPOINT_URL=
S3_BUCKET=naqshkaar-catalogue
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Fail 3D qualification if the Khronos glTF validator cannot run.
REQUIRE_GLTF_VALIDATOR=true

# Ingest API: create a retailer automatically when a collector sends an unknown slug.
INGEST_AUTO_CREATE_RETAILER=true

# Key used by the 3D worker containers (scope: worker). The setup script fills it.
# By hand: Settings > API keys in the web UI.
WORKER_API_KEY=
# Engines for the CPU worker container. Add ,trellis_hf for TRELLIS on Hugging Face
# (free, no GPU) or ,meshy to use the paid Meshy API.
CPU_ENGINES=mock
MESHY_API_KEY=
# Optional for trellis_hf: a free Hugging Face read token raises the Space's GPU quota.
HF_TOKEN=
TRELLIS_HF_SPACE=trellis-community/TRELLIS
