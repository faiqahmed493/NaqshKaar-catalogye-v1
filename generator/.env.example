# Copy to generator/.env (or export these) on each GPU machine.
STUDIO_URL=http://localhost:8000          # the backend API, or your tunnel URL when running on Colab
STUDIO_API_KEY=nqk_xxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # scope: worker
WORKER_ID=lab-gpu-trellis
ENGINES=trellis                           # comma list; one environment per engine is recommended
WORK_DIR=./work
POLL_SECONDS=5
GPU_LOCK_FILE=/tmp/naqshkaar-gpu.lock     # serialises GPU use between workers on one machine
MAX_LOADED_ENGINES=1

# Engine locations (only for the engines listed in ENGINES)
TRELLIS_REPO=/opt/TRELLIS
TRELLIS2_REPO=/opt/TRELLIS.2
TRIPOSR_REPO=/opt/TripoSR
HUNYUAN21_REPO=/opt/Hunyuan3D-2.1
SF3D_REPO=/opt/stable-fast-3d
INSTANTMESH_REPO=/opt/InstantMesh
INSTANTMESH_PYTHON=/opt/conda/envs/instantmesh/bin/python
# GENERATOR_COMMAND_TEMPLATE=python /opt/mymodel/run.py --image {input} --out {output_dir}
# MESHY_API_KEY=msy_...                   # optional commercial API
